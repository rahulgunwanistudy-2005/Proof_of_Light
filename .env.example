# Copy to .env (ignored), then use: .venv/bin/python -m uvicorn apps.api.main:app --env-file .env
# Generate a long merchant-only token locally. Never share it with buyer flows.
POL_MERCHANT_ID=kiln-and-ash
POL_MERCHANT_TOKEN=
DATABASE_URL=sqlite:///./pol-local.db

# Sandbox credentials only. PayPal integration is not implemented yet.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox

# Kept server-side; model choice will be checked before AI integration.
GEMINI_API_KEY=
